{
    "keyboard_name": "Keychron C3 Pro 8K",
    "manufacturer": "Keychron",
    "url": "https://github.com/Keychron",
    "maintainer": "Keychron",
    "processor": "AT32F405",
    "bootloader": "at32-dfu",
    "usb": {
        "vid": "0x3434"
    },
    "features": {
        "bootmagic": true,
        "command": false,
        "console": false,
        "extrakey": true,
        "mousekey": true,
        "nkro": true,
        "rgb_matrix": true
    },
    "matrix_pins": {
        "cols": ["A10", "A11", "A12", "A14", "B7", "C13", "C14", "C15", "C0", "C1", "C2", "C3", "A0", "A1", "A2", "A3", "A4"],
        "rows": ["C12", "D2", "B3", "B4", "B5", "B6"]
    },
    "diode_direction": "COL2ROW",
    "indicators": {
        "caps_lock": "A6"
    },
    "build": {
        "debounce_type": "custom"
    },
    "debounce": 30,
    "eeprom": {
        "wear_leveling": {
            "driver": "embedded_flash",
            "logical_size": 3072,
            "backing_size": 6144
        }
    },
    "rgb_matrix": {
        "driver": "snled27351_spi",
        "sleep": true,
        "animations": {}
    }
}
